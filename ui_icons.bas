' -------------------------------------------------------------------------
' Checked atlas access
' -------------------------------------------------------------------------

Public Function uiIcons_IsValid(ByVal iconId As Integer) As Integer
    Return IIf(iconId >= 0 AndAlso iconId < OSE_UI_ICON_COUNT, -1, 0)
End Function


Public Function uiIcons_Name(ByVal iconId As Integer) As String
    Select Case iconId
        Case OSE_UI_ICON_POINTER
            Return "Pointer"
        Case OSE_UI_ICON_NOTE
            Return "Add Note"
        Case OSE_UI_ICON_TRASH
            Return "Delete"
        Case OSE_UI_ICON_CUT
            Return "Cut"
        Case OSE_UI_ICON_PASTE
            Return "Paste"
        Case OSE_UI_ICON_STOP
            Return "Stop"
        Case OSE_UI_ICON_PAUSE
            Return "Pause"
        Case OSE_UI_ICON_REWIND
            Return "Rewind"
        Case OSE_UI_ICON_PLAY
            Return "Play"
        Case OSE_UI_ICON_FORWARD
            Return "Fast Forward"
        Case OSE_UI_ICON_RECORD
            Return "Record"
        Case OSE_UI_ICON_STEP
            Return "Step Record"
    End Select
    Return ""
End Function


Public Function uiIcons_GetRow( _
    ByVal iconId As Integer, _
    ByVal rowIndex As Integer, _
    ByRef rowText As String _
) As Integer
    rowText = ""
    If uiIcons_IsValid(iconId) = 0 OrElse _
        rowIndex < 0 OrElse rowIndex >= OSE_UI_ICON_SIZE Then
        Return 0
    End If

    Select Case iconId
        Case OSE_UI_ICON_POINTER
            rowText = UI_ICON_POINTER_ROWS(rowIndex)
        Case OSE_UI_ICON_NOTE
            rowText = UI_ICON_NOTE_ROWS(rowIndex)
        Case OSE_UI_ICON_TRASH
            rowText = UI_ICON_TRASH_ROWS(rowIndex)
        Case OSE_UI_ICON_CUT
            rowText = UI_ICON_CUT_ROWS(rowIndex)
        Case OSE_UI_ICON_PASTE
            rowText = UI_ICON_PASTE_ROWS(rowIndex)
        Case OSE_UI_ICON_STOP
            rowText = UI_ICON_STOP_ROWS(rowIndex)
        Case OSE_UI_ICON_PAUSE
            rowText = UI_ICON_PAUSE_ROWS(rowIndex)
        Case OSE_UI_ICON_REWIND
            rowText = UI_ICON_REWIND_ROWS(rowIndex)
        Case OSE_UI_ICON_PLAY
            rowText = UI_ICON_PLAY_ROWS(rowIndex)
        Case OSE_UI_ICON_FORWARD
            rowText = UI_ICON_FORWARD_ROWS(rowIndex)
        Case OSE_UI_ICON_RECORD
            rowText = UI_ICON_RECORD_ROWS(rowIndex)
        Case OSE_UI_ICON_STEP
            rowText = UI_ICON_STEP_ROWS(rowIndex)
    End Select
    Return IIf(Len(rowText) = OSE_UI_ICON_SIZE, -1, 0)
End Function


Public Function uiIcons_DecodeCoverage( _
    ByVal maskCharacter As UByte _
) As Integer
    Dim As Integer coverageLevel
    Select Case maskCharacter
        ' ASCII digits occupy consecutive byte values 48 through 57.
        Case 48 To 57
            coverageLevel = maskCharacter - 48
        ' Uppercase A through F occupy consecutive values 65 through 70.
        Case 65 To 70
            coverageLevel = maskCharacter - 65 + 10
        Case Else
            Return 0
    End Select

    ' Fifteen equal intervals cover the complete 0..255 alpha range.
    Return coverageLevel * 17
End Function


Public Function uiIcons_Coverage( _
    ByVal iconId As Integer, _
    ByVal pixelX As Integer, _
    ByVal pixelY As Integer _
) As Integer
    If pixelX < 0 OrElse pixelX >= OSE_UI_ICON_SIZE Then
        Return 0
    End If

    Dim As String rowText
    If uiIcons_GetRow(iconId, pixelY, rowText) = 0 Then
        Return 0
    End If
    Return uiIcons_DecodeCoverage(rowText[pixelX])
End Function


Public Function uiIcons_CenteredOffset( _
    ByVal containerExtent As Integer _
) As Integer
    If containerExtent <= OSE_UI_ICON_SIZE Then
        Return 0
    End If
    Return (containerExtent - OSE_UI_ICON_SIZE) \ 2
End Function


