# Project: OpenSesh
# File: .gitattributes
# Keep scripts portable while preserving byte-pinned third-party payloads.
* text=auto eol=lf
*.bas text eol=lf
*.bi text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.png binary
*.ogf binary
# SNAPSHOT.sha256 records exact upstream bytes, including line endings.
vendor/** -text -eol

# Preserve byte-pinned license text and the mandatory blank context lines in
# unified patches. Application source still receives normal whitespace checks.
vendor/omaGui/LICENSES/* -whitespace
tools/fblint/*.patch -whitespace
# end of .gitattributes
