/*
    Project: OpenMidiSesh
    ---------------------------

    File: openmidisesh.rc

    Purpose:

        Embed stable Windows Explorer version information in release builds.

    Responsibilities:

        - identify the product and executable
        - expose numeric and display versions to Windows
        - embed the reviewed privilege, compatibility, and DPI manifest
        - mark this pre-1.0 build as a development build

    This file intentionally does NOT contain:

        - application runtime behavior
        - icons or other visual assets
        - Linux metadata
*/

#define RT_MANIFEST 24

1 RT_MANIFEST "openmidisesh.manifest"

1 VERSIONINFO
 FILEVERSION 0,9,0,0
 PRODUCTVERSION 0,9,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x2L
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenMidiSesh contributors\0"
            VALUE "FileDescription", "OpenMidiSesh\0"
            VALUE "FileVersion", "0.9.0-dev\0"
            VALUE "InternalName", "openmidisesh\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 OpenMidiSesh contributors\0"
            VALUE "OriginalFilename", "openmidisesh.exe\0"
            VALUE "ProductName", "OpenMidiSesh\0"
            VALUE "ProductVersion", "0.9.0-dev\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

/* end of openmidisesh.rc */
