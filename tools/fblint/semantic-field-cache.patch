-' -------------------------------------------------------------------------
-' Scoped secondary-model validation
-' -------------------------------------------------------------------------
-
-Type Schema27IndexSnapshot
-    Rows(Any) As Schema27Record
-    Aliases(Any) As Schema27AliasRecord
-    HashHeads(Any) As LongInt
-    AliasHeads(Any) As LongInt
-    TagHeads(0 To 67) As LongInt
-    TagTails(0 To 67) As LongInt
-    TagCounts(0 To 67) As LongInt
-    RowCount As Long
-    Capacity As Long
-    AliasCount As Long
-    AliasCapacity As Long
-    HashSize As Integer
-    LinePoolUsed As Long
-    LinePool As String
-    IndexNonce As LongInt
-    FactsComplete As Integer
-    Failure As String
-    StatementTop As String
-    ConstructTop As String
-    ConditionalTop As String
-    Active As Integer
-End Type
-
-Function Schema27SuspendIndex(ByRef Saved As Schema27IndexSnapshot) As Integer
-    If Saved.Active <> 0 OrElse Schema27RowCount < 0 OrElse _
-       Schema27Capacity < Schema27RowCount OrElse _
-       Schema27HashSize < SCHEMA27_HASH_SIZE OrElse _
-       Schema27HashSize > SCHEMA27_MAX_HASH_SIZE Then Return 0
-    Saved.RowCount = Schema27RowCount
-    Saved.Capacity = Schema27RowCount + 1
-    Saved.AliasCount = Schema27AliasCount
-    Saved.AliasCapacity = Schema27AliasCount + 1
-    Saved.HashSize = Schema27HashSize
-    Saved.LinePoolUsed = Schema27LinePoolUsed
-    Swap Schema27LinePool, Saved.LinePool
-    Saved.IndexNonce = Schema27IndexNonce
