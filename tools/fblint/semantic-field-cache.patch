-' -------------------------------------------------------------------------
-' Complete-model entry point
-' -------------------------------------------------------------------------
-
-Function FblintValidateSchema27Metadata(ByRef ModelPath As String, _
-    LatestTypes() As String, CanonicalIds() As LongInt) As Integer
-    Dim As Integer FileNumber = FreeFile
-    Dim As Integer Valid = -1, FirstLine = -1, FooterSeen
-    Dim As LongInt ModuleOrdinal, FileSize
-    Dim As UByte FinalByte
-    Dim As String LineText
-    Dim As String Fields(0 To 18)
-    ResetSchema27Facts
-    Erase LatestTypes
-    Erase CanonicalIds
-    If Open(ModelPath For Binary Access Read As #FileNumber) <> 0 Then Return 0
-    FileSize = Lof(FileNumber)
-    If FileSize > 0 Then Get #FileNumber, FileSize, FinalByte
-    Close #FileNumber
-    If FileSize = 0 OrElse FileSize > SCHEMA27_BYTE_LIMIT OrElse FinalByte <> 10 Then Return 0
-    While Schema27HashSize < SCHEMA27_MAX_HASH_SIZE AndAlso _
-          Schema27HashSize < FileSize \ SCHEMA27_HASH_ROW_BYTES
-        Schema27HashSize *= 2
-    Wend
-    Schema27Trace("schema 27 index: " + ModelPath)
-    Schema27LinePool = Space$(FileSize)
-    Schema27LinePoolUsed = 0
-    If Open(ModelPath For Input As #FileNumber) <> 0 Then Return 0
-    Do While Eof(FileNumber) = 0
-        Line Input #FileNumber, LineText
-        If FooterSeen <> 0 OrElse Schema20Fields(LineText, Fields(), "27") = 0 Then Valid = 0: Exit Do
-        If FirstLine <> 0 Then
-            FirstLine = 0
-            If Fields(0) <> "FBCSEM" OrElse Fields(1) <> "27" OrElse Len(Fields(2)) = 0 Then Valid = 0: Exit Do
-        ElseIf Fields(0) = "FBCSEM" OrElse Fields(0) = "R" Then
-            Valid = 0: Exit Do
-        End If
-        If Fields(0) = "M" Then ModuleOrdinal += 1
-        If Schema27ValidateSourceRecord(Fields(), ModuleOrdinal) = 0 OrElse _
-           Schema27Add(Fields(), LineText, ModuleOrdinal) = 0 Then
-            Schema27Failure = "record " + Fields(0)
-            Valid = 0: Exit Do
-        End If
-        If Fields(0) = "END" Then FooterSeen = -1
-    Loop
-    Valid = (Valid <> 0 AndAlso FooterSeen <> 0 AndAlso Eof(FileNumber) <> 0)
-    Close #FileNumber
-    Schema27Trace("schema 27 indexed rows=" + LTrim(Str(Schema27RowCount)))
-    If Valid <> 0 Then Valid = Schema27ValidateGraphs()
-    If Valid <> 0 Then
-        Schema27Failure = "shared symbol metadata"
-        Schema27Trace("schema 27 shared symbol metadata")
-        Valid = FblintValidateSchema20Metadata(ModelPath, LatestTypes(), CanonicalIds(), "27")
-    End If
-    If Valid = 0 Then
-        Dim As String FailureText = Schema27Failure
-        ResetSchema27Facts
-        Schema27Failure = FailureText
-        Erase LatestTypes
-        Erase CanonicalIds
-    Else
-        Schema27Failure = ""
-        Schema27FactsComplete = -1
-    End If
-    Schema27Trace("schema 27 metadata status=" + LTrim(Str(Valid)))
-    Return Valid
-End Function
