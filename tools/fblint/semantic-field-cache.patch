+' Project: fb-linter
+' File: fb_linter_semantic_schema27.bi
+' Purpose: Validate and retain the compiler's complete schema-27 model.
+' Responsibilities: Bounded record indexing, provenance and graph validation.
+' This file intentionally does NOT parse source or reconstruct compiler facts.
+'
+' Ownership: The per-analysis index owns its strings and arrays. A rejected
+' model releases the entire index. The shared schema-20 identity kernel checks
+' unchanged symbol metadata only after the new graph has passed validation.
+#Ifndef FB_LINTER_SEMANTIC_SCHEMA27_BI
+#Define FB_LINTER_SEMANTIC_SCHEMA27_BI
+
+#Ifdef FBLINT_SCHEMA27_TRACE
+#Define Schema27Trace(MessageText) TraceLog MessageText
+#Else
+#Define Schema27Trace(MessageText)
+#Endif
+
+' -------------------------------------------------------------------------
+' Per-model record index
+' -------------------------------------------------------------------------
+
+' These are consumer budgets, not assertions about the compiler's limits.
+' Refusing an oversized model is an analysis failure, never partial success.
+Const SCHEMA27_BYTE_LIMIT As LongInt = 512 * 1024 * 1024
+Const SCHEMA27_ROW_LIMIT As LongInt = 16 * 1024 * 1024
+Const SCHEMA27_HASH_SIZE As Integer = 65536
+' Large exports need more buckets to keep decoded-key comparisons bounded in
+' practice. Two fixed arrays cost at most eight MiB; small models retain the
+' original hash width. Neither the byte budget nor record validation changes.
+Const SCHEMA27_MAX_HASH_SIZE As Integer = 1048576
+Const SCHEMA27_HASH_ROW_BYTES As Integer = 128
+Const SCHEMA27_FNV_OFFSET As ULong = 2166136261
+Const SCHEMA27_FNV_PRIME As ULong = 16777619
+Const SCHEMA27_TAGS As String = "|FBCSEM|M|D|S|B|I|P|V|N|E|END|T|A|F|G|U|C|H|K|J|O|Q|Y|Z|ASM|DCL|CTX|OPT|USE|FILE|SRC|SRE|INC|MAP|ORIG|LOC|PPB|PPD|PPE|PPT|PPS|MD|MT|MI|MA|MS|MC|ME|ML|MR|ST|STE|BLK|BEND|OWN|CAP|ACC|SOP|EX|NT|PH|NP|EV|CB|CN|CE|CL|DI|"
+
+Type Schema27Record
+    LineOffset As Long
+    LineLength As Long
+    KeyText As String
+    NextTag As Long
+    NextHash As Long
+    AliasIndex As Long
+    ModuleOrdinal As Long
+    WorkCount As Long
+    WorkValue As Long
+    WorkOrdinal As Long
+End Type
+
+Type Schema27AliasRecord
+    KeyText As String
+    RowIndex As Long
+    NextHash As Long
+End Type
+
+' This state belongs to one root analysis. No other thread may read it while
+' a model is being built or reset, matching the existing semantic indexes.
+Dim Shared Schema27Rows() As Schema27Record
+Dim Shared Schema27Aliases() As Schema27AliasRecord
+Dim Shared As Long Schema27RowCount, Schema27Capacity
+Dim Shared As Long Schema27AliasCount, Schema27AliasCapacity
+Dim Shared As Long Schema27LinePoolUsed
+Dim Shared As String Schema27LinePool
+Dim Shared As Long Schema27TagHeads(0 To 67), Schema27TagTails(0 To 67)
+Dim Shared As Long Schema27TagCounts(0 To 67)
+Dim Shared As Long Schema27HashHeads(0 To SCHEMA27_MAX_HASH_SIZE - 1)
+Dim Shared As Long Schema27AliasHeads(0 To SCHEMA27_MAX_HASH_SIZE - 1)
+Dim Shared As Integer Schema27HashSize = SCHEMA27_HASH_SIZE
+Dim Shared As Integer Schema27FactsComplete
+Dim Shared As String Schema27Failure
+
+' A nonce belongs to the indexed rows, including while a replay suspends them.
+' Restoring those exact rows restores their nonce; a fresh load gets a new one.
+' At exhaustion, zero disables dependent caches instead of reusing an identity.
+Const SCHEMA27_INDEX_NONCE_MAX As LongInt = &h7FFFFFFFFFFFFFFF
+Dim Shared As LongInt Schema27IndexNonce, Schema27IndexSequence
+
+Sub ResetSchema27Facts()
+    Schema27IndexNonce = 0
+    If Schema27IndexSequence < SCHEMA27_INDEX_NONCE_MAX Then
+        Schema27IndexSequence += 1
+        Schema27IndexNonce = Schema27IndexSequence
+    End If
+    Erase Schema27Rows
+    Erase Schema27Aliases
+    Erase Schema27TagHeads
+    Erase Schema27TagTails
+    Erase Schema27TagCounts
+    Erase Schema27HashHeads
+    Erase Schema27AliasHeads
+    Schema27HashSize = SCHEMA27_HASH_SIZE
+    Schema27RowCount = 0
+    Schema27Capacity = 0
+    Schema27AliasCount = 0
+    Schema27AliasCapacity = 0
+    Schema27LinePoolUsed = 0
+    Schema27LinePool = ""
+    Schema27FactsComplete = 0
+    Schema27Failure = ""
+End Sub
+
+Function Schema27Tag(ByRef TagText As String) As Integer
+    ' The tag vocabulary never changes. Cache its byte-position ordinals once
+    ' instead of allocating a one-character Mid string for every preceding
+    ' byte on every record, lookup and count query.
+    Static As Integer Ordinals(0 To Len(SCHEMA27_TAGS))
+    Static As Integer Initialized
+    If Initialized = 0 Then
+        Dim As Integer TagIndex
+        For I As Integer = 1 To Len(SCHEMA27_TAGS)
+            Ordinals(I) = TagIndex
+            If Asc(SCHEMA27_TAGS, I) = Asc("|") Then TagIndex += 1
+        Next I
+        Initialized = -1
+    End If
+    Dim As Integer Position = InStr(SCHEMA27_TAGS, "|" + TagText + "|")
+    If Position = 0 Then Return -1
+    Return Ordinals(Position)
+End Function
+
+Function Schema27Key(ByVal TagText As String, ByVal First As String = "", _
+    ByVal Second As String = "", ByVal Third As String = "") As String
+    ' Length prefixes keep names containing separators distinct. The index
+    ' holds decoded bytes; it never performs a second percent-unescape pass.
+    Return TagText + ":" + LTrim(Str(Len(First))) + ":" + First + _
+        LTrim(Str(Len(Second))) + ":" + Second + LTrim(Str(Len(Third))) + ":" + Third
+End Function
+
+Function Schema27Hash(ByRef KeyText As String) As ULong
+    ' FNV-1a mixes each decoded byte into a fixed-width unsigned accumulator;
+    ' its 32-bit wrap is intentional on both 32-bit and 64-bit hosts.
+    ' Full key equality, not the hash, still decides record identity.
+    Dim As ULong HashValue = SCHEMA27_FNV_OFFSET
+    For I As Integer = 1 To Len(KeyText)
+        HashValue = (HashValue Xor CULng(Asc(KeyText, I))) * SCHEMA27_FNV_PRIME
+    Next I
+    Return HashValue
+End Function
+
+Function Schema27Bucket(ByRef KeyText As String) As Integer
+    ' Rule-owned indexes retain their original fixed-width bucket contract.
+    Return Schema27Hash(KeyText) And (SCHEMA27_HASH_SIZE - 1)
+End Function
+
+Function Schema27IndexBucket(ByRef KeyText As String) As Integer
+    ' Only the model-owned tables use the larger active bucket width.
+    Return Schema27Hash(KeyText) And (Schema27HashSize - 1)
+End Function
+
+Function Schema27Find(ByVal TagText As String, ByVal First As String = "", _
+    ByVal Second As String = "", ByVal Third As String = "") As Long
+    Dim As String KeyText = Schema27Key(TagText, First, Second, Third)
+    Dim As Long RowIndex = Schema27HashHeads(Schema27IndexBucket(KeyText))
+    Do While RowIndex > 0
+        If Schema27Rows(RowIndex).KeyText = KeyText Then Return RowIndex
+        RowIndex = Schema27Rows(RowIndex).NextHash
+    Loop
+    Return 0
+End Function
+
+Function Schema27LineText(ByVal RowIndex As Long) As String
+    If RowIndex < 1 OrElse RowIndex > Schema27RowCount Then Return ""
+    If Schema27Rows(RowIndex).LineLength = 0 Then Return ""
+    Return Mid$(Schema27LinePool, Schema27Rows(RowIndex).LineOffset + 1, _
+        Schema27Rows(RowIndex).LineLength)
+End Function
+
+Function Schema27Fields(ByVal RowIndex As Long, Fields() As String) As Integer
+    Dim As String LineText = Schema27LineText(RowIndex)
+    Return Schema20Fields(LineText, Fields(), "27")
+End Function
+
+Function Schema27UncachedValue(ByVal RowIndex As Long, ByVal FieldIndex As Integer) As String
+    Dim As String Result, LineText
+    If RowIndex < 1 OrElse RowIndex > Schema27RowCount Then Return ""
+    LineText = Schema27LineText(RowIndex)
+    If FblintSemanticDecodeField(FblintTsvField(LineText, FieldIndex), Result) = 0 Then Return ""
+    Return Result
+End Function
+
+' One derived cache belongs to the exact immutable row index. A replacement
+' index, restored snapshot or changed budget causes a fresh set of boundaries.
+' Raw offsets and pooled bytes are immutable for that index; row work fields
+' remain independent. The scan is single-threaded. The cap covers retained
+' arrays, and a low budget leaves uncached reads available.
+Const SCHEMA27_FIELD_CACHE_BYTES As LongInt = 128 * 1024 * 1024
+Dim Shared As LongInt Schema27FieldCacheBudget = SCHEMA27_FIELD_CACHE_BYTES
+Dim Shared As LongInt Schema27FieldCacheOwner, Schema27FieldCacheOwnerBudget
+Dim Shared As Long Schema27FieldCacheRows, Schema27FieldCacheUsed = 1, Schema27FieldCacheCapacity
+Dim Shared Schema27FieldCacheMap() As Long
+Dim Shared Schema27FieldCacheStarts() As ULong
+Dim Shared As Integer Schema27FieldCacheDisabled
+
+Function Schema27Value(ByVal RowIndex As Long, ByVal FieldIndex As Integer) As String
+    If RowIndex < 1 OrElse RowIndex > Schema27RowCount OrElse FieldIndex < 0 Then Return ""
+    If Schema27IndexNonce <= 0 OrElse Schema27FactsComplete = 0 Then Return Schema27UncachedValue(RowIndex, FieldIndex)
+    If Schema27FieldCacheOwner <> Schema27IndexNonce OrElse Schema27FieldCacheRows <> Schema27RowCount OrElse Schema27FieldCacheOwnerBudget <> Schema27FieldCacheBudget Then
+        Erase Schema27FieldCacheMap
+        Erase Schema27FieldCacheStarts
+        Schema27FieldCacheUsed = 1
+        Schema27FieldCacheCapacity = 0
+        Schema27FieldCacheDisabled = 0
+        Schema27FieldCacheOwner = Schema27IndexNonce
+        Schema27FieldCacheRows = Schema27RowCount
+        Schema27FieldCacheOwnerBudget = Schema27FieldCacheBudget
+        If Schema27FieldCacheBudget <= 0 OrElse Schema27FieldCacheBudget > SCHEMA27_FIELD_CACHE_BYTES OrElse _
+           (CLngInt(Schema27FieldCacheRows) + 1) * Sizeof(Long) >= Schema27FieldCacheBudget Then
+            Schema27FieldCacheDisabled = -1
+        Else
+            ReDim Schema27FieldCacheMap(0 To Schema27FieldCacheRows)
+        End If
+    End If
+    If Schema27FieldCacheDisabled Then Return Schema27UncachedValue(RowIndex, FieldIndex)
+    Dim As Long Slot = Schema27FieldCacheMap(RowIndex)
+    If Slot = 0 Then
+        Dim As String LineText = Schema27LineText(RowIndex)
+        Dim As Long FieldCount = FblintTsvFieldCount(LineText)
+        Dim As LongInt Needed = CLngInt(Schema27FieldCacheUsed) + FieldCount + 2
+        Dim As LongInt Available = (Schema27FieldCacheBudget - (CLngInt(Schema27FieldCacheRows) + 1) * Sizeof(Long)) \ Sizeof(ULong)
+        If Needed > Available Then
+            Schema27FieldCacheMap(RowIndex) = -1
+            Return Schema27UncachedValue(RowIndex, FieldIndex)
+        End If
+        If Needed > Schema27FieldCacheCapacity Then
+            Dim As LongInt NewCapacity = IIf(Schema27FieldCacheCapacity = 0, 1024, Schema27FieldCacheCapacity)
+            Do While NewCapacity < Needed
+                NewCapacity *= 2
+            Loop
+            If NewCapacity > Available Then NewCapacity = Available
+            If Schema27FieldCacheCapacity = 0 Then
+                ReDim Schema27FieldCacheStarts(0 To NewCapacity - 1)
+            Else
+                ReDim Preserve Schema27FieldCacheStarts(0 To NewCapacity - 1)
+            End If
+            Schema27FieldCacheCapacity = NewCapacity
+        End If
+        Slot = Schema27FieldCacheUsed
+        Schema27FieldCacheStarts(Slot) = FieldCount
+        Dim As Long StartPosition = 0
+        For Index As Long = 0 To FieldCount - 1
+            Schema27FieldCacheStarts(Slot + 1 + Index) = StartPosition
+            If Index < FieldCount - 1 Then StartPosition = InStr(StartPosition + 1, LineText, Chr(9))
+        Next Index
+        Schema27FieldCacheStarts(Slot + FieldCount + 1) = Len(LineText) + 1
+        Schema27FieldCacheUsed = Needed
+        ' Publish only the complete boundaries for this row.
+        Schema27FieldCacheMap(RowIndex) = Slot
+    End If
+    If Slot < 0 Then Return Schema27UncachedValue(RowIndex, FieldIndex)
+    If FieldIndex >= Schema27FieldCacheStarts(Slot) Then Return ""
+    Dim As LongInt FieldStart = Schema27FieldCacheStarts(Slot + 1 + FieldIndex)
+    Dim As LongInt FieldLength = Schema27FieldCacheStarts(Slot + 2 + FieldIndex) - FieldStart - 1
+    Dim As String ResultText
+    If FblintSemanticDecodeField(Mid(Schema27LinePool, Schema27Rows(RowIndex).LineOffset + 1 + FieldStart, FieldLength), ResultText) = 0 Then Return ""
+    Return ResultText
+End Function
+
+Function Schema27Alias(ByRef KeyText As String) As Long
+    Dim As Long AliasIndex = Schema27AliasHeads(Schema27IndexBucket(KeyText))
+    Do While AliasIndex > 0
+        If Schema27Aliases(AliasIndex).KeyText = KeyText Then Return Schema27Aliases(AliasIndex).RowIndex
+        AliasIndex = Schema27Aliases(AliasIndex).NextHash
+    Loop
+    Return 0
+End Function
+
+Function Schema27AddAlias(ByVal RowIndex As Long, ByRef KeyText As String, _
+    ByVal Refresh As Integer = 0) As Integer
+    Dim As Integer Bucket = Schema27IndexBucket(KeyText)
+    If RowIndex < 1 OrElse RowIndex > Schema27RowCount OrElse Schema27Rows(RowIndex).AliasIndex > 0 Then Return 0
+    If Refresh = 0 AndAlso Schema27Alias(KeyText) > 0 Then Return 0
+    If Schema27AliasCount + 1 >= Schema27AliasCapacity Then
+        Dim As Long NewCapacity = Schema27AliasCapacity * 2
+        If NewCapacity = 0 Then NewCapacity = 16
+        ReDim Preserve Schema27Aliases(0 To NewCapacity - 1) As Schema27AliasRecord
+        Schema27AliasCapacity = NewCapacity
+    End If
+    Schema27AliasCount += 1
+    With Schema27Aliases(Schema27AliasCount)
+        .KeyText = KeyText
+        .RowIndex = RowIndex
+        .NextHash = Schema27AliasHeads(Bucket)
+    End With
+    Schema27Rows(RowIndex).AliasIndex = Schema27AliasCount
+    Schema27AliasHeads(Bucket) = Schema27AliasCount
+    Return -1
+End Function
+
+Function Schema27Number(ByVal RowIndex As Long, ByVal FieldIndex As Integer) As LongInt
+    Dim As LongInt Result
+    Dim As String TextValue = Schema27Value(RowIndex, FieldIndex)
+    If FblintParseSemanticSignedInteger(TextValue, Result) = 0 Then Return -1
+    Return Result
+End Function
+
+Function Schema27First(ByVal TagText As String) As Long
+    Dim As Integer TagIndex = Schema27Tag(TagText)
+    If TagIndex < 0 Then Return 0
+    Return Schema27TagHeads(TagIndex)
+End Function
+
+Function Schema27Count(ByVal TagText As String) As Long
+    Dim As Integer TagIndex = Schema27Tag(TagText)
+    If TagIndex < 0 Then Return 0
+    Return Schema27TagCounts(TagIndex)
+End Function
+
+Function Schema27BuildCoreRows(CoreRows() As Long, ByRef DetailRows As LongInt) As Long
+    ' All detail records remain in the validated index for rule consumers.
+    ' Merge tag chains by their original row positions: procedure and node
+    ' context depends on export order, so concatenating tag lists is unsafe.
+    If Schema27FactsComplete = 0 Then Return 0
+    Dim As String Tags(0 To 9) = {"M", "D", "S", "B", "I", "P", "V", "N", "E", "END"}
+    Dim As Long Positions(0 To 9)
+    Dim As Long CoreCount
+    For TagIndex As Integer = 0 To 9
+        Dim As Integer Ordinal = Schema27Tag(Tags(TagIndex))
+        If Ordinal < 0 OrElse Ordinal > UBound(Schema27TagHeads) Then Return 0
+        Positions(TagIndex) = Schema27TagHeads(Ordinal)
+        If Schema27TagCounts(Ordinal) > Schema27RowCount - CoreCount Then Return 0
+        CoreCount += Schema27TagCounts(Ordinal)
+    Next TagIndex
+    DetailRows = Schema27RowCount - CoreCount - Schema27Count("FBCSEM")
+    If CoreCount < 1 OrElse DetailRows < 0 Then Return 0
+    ReDim CoreRows(0 To CoreCount - 1)
+    For CoreIndex As Long = 0 To CoreCount - 1
+        Dim As Integer Selected = -1
+        For TagIndex As Integer = 0 To 9
+            If Positions(TagIndex) = 0 Then Continue For
+            If Selected < 0 Then
+                Selected = TagIndex
+            ElseIf Positions(TagIndex) < Positions(Selected) Then
+                Selected = TagIndex
+            End If
+        Next TagIndex
+        If Selected < 0 Then Erase CoreRows: Return 0
+        Dim As Long RowIndex = Positions(Selected)
+        If RowIndex < 1 OrElse RowIndex > Schema27RowCount Then Erase CoreRows: Return 0
+        CoreRows(CoreIndex) = RowIndex
+        Positions(Selected) = Schema27Rows(RowIndex).NextTag
+    Next CoreIndex
+    Return CoreCount
+End Function
+
+Function Schema27Add(Fields() As String, ByRef LineText As String, _
+    ByVal ModuleOrdinal As LongInt) As Integer
+
+    Dim As String TagText = Fields(0)
+    Dim As String First = Fields(1), Second, Third
+    Dim As Integer TagIndex = Schema27Tag(TagText)
+    Dim As Integer Refresh
+    Dim As String KeyText
+    Dim As Integer Bucket
+    Dim As LongInt OldIndex, IdentityLimit
+    Dim As Long NewCapacity
+    If TagIndex < 0 OrElse TagIndex > UBound(Schema27TagHeads) Then Return 0
+    If TagText = "S" OrElse TagText = "N" OrElse TagText = "E" Then
+        ' Only symbol identities index the bounded symbol-type table. Node and
+        ' expression identities are row-backed and follow the model row budget.
+        IdentityLimit = SCHEMA27_ROW_LIMIT
+        If TagText = "S" Then IdentityLimit = FBLINT_MAX_SEMANTIC_SYMBOL_TYPES
+        If Schema20Decimal(Fields(1), 0) = 0 OrElse _
+           FblintParseSemanticInteger(Fields(1), OldIndex) = 0 OrElse OldIndex < 1 OrElse _
+           OldIndex > IdentityLimit Then
+            Schema27Failure = "invalid " + TagText + " identity " + Fields(1)
+            Return 0
+        End If
+    End If
+    Select Case TagText
+    Case "M", "B", "I", "P", "V", "D", "H", "J", "O", "CE", "SOP", "A", "Z"
+        First = LTrim(Str(Schema27Count(TagText) + 1))
+    Case "Q": First = LTrim(Str(ModuleOrdinal))
+    Case "Y": First = LTrim(Str(ModuleOrdinal)): Second = Fields(1)
+    Case "T", "F", "G", "U", "C", "K": Refresh = -1
+    End Select
+    Select Case TagText
+    Case "G": Second = Fields(3)
+    Case "C", "USE", "ORIG", "OWN": Second = Fields(2)
+    Case "K", "NT", "LOC", "MR": Second = Fields(2): Third = Fields(3)
+    Case "OPT": Second = Fields(2): Third = Fields(3)
+    Case "MT": Second = IIf(Fields(3) = "parameter", "formal", "body"): Third = Fields(2)
+    Case "MA", "MS", "ASM", "EV", "CL", "CAP": Second = Fields(2)
+    Case "MAP": First = Fields(10)
+    End Select
+    If TagText = "MR" Then Third = Fields(4)
+    If TagText = "NT" AndAlso Fields(1) = "symbol" Then Refresh = -1
+    KeyText = Schema27Key(TagText, First, Second, Third)
+    OldIndex = Schema27Find(TagText, First, Second, Third)
+    If OldIndex > 0 AndAlso Refresh = 0 Then
+        Schema27Failure = "duplicate semantic key " + KeyText
+        Return 0
+    End If
+    If TagText = "K" AndAlso OldIndex > 0 AndAlso Left(Fields(3), 24) = "unevaluated-query-range-" Then Return 0
+    If TagText = "K" AndAlso OldIndex > 0 AndAlso Left(Fields(3), 12) = "select-case-" Then Return 0
+    If TagText = "K" AndAlso OldIndex > 0 AndAlso _
+       (Schema20Choice(Fields(3), "|formal-span-kind|assignment-target-dtype|assignment-kind|unevaluated-query-input|") OrElse _
+        Left(Fields(3), 11) = "size-query-" OrElse Left(Fields(3), 16) = "pointer-address-" OrElse _
+        Left(Fields(3), 11) = "memory-new-" OrElse Left(Fields(3), 15) = "memory-release-" OrElse _
+        Left(Fields(3), 17) = "numeric-selected-" OrElse Left(Fields(3), 16) = "numeric-literal-" OrElse _
+        Left(Fields(3), 20) = "pointer-dereference-" OrElse Left(Fields(3), 14) = "pointer-index-" OrElse _
+        Left(Fields(3), 19) = "string-initializer-" OrElse Left(Fields(3), 15) = "loop-condition-" OrElse _
+        Left(Fields(3), 16) = "array-subscript-" OrElse Left(Fields(3), 12) = "array-bound-" OrElse Fields(3) = "call-argument-expression") Then
+        If Schema27Value(OldIndex, 4) <> Fields(4) Then Return 0
+    End If
+    If Schema27RowCount >= SCHEMA27_ROW_LIMIT Then Return 0
+    If Schema27RowCount + 1 >= Schema27Capacity Then
+        NewCapacity = Schema27Capacity * 2
+        If NewCapacity = 0 Then NewCapacity = 256
+        If NewCapacity > SCHEMA27_ROW_LIMIT + 1 Then NewCapacity = SCHEMA27_ROW_LIMIT + 1
+        ReDim Preserve Schema27Rows(0 To NewCapacity - 1) As Schema27Record
+        Schema27Capacity = NewCapacity
+    End If
+    If Schema27LinePoolUsed < 0 OrElse Len(LineText) > Len(Schema27LinePool) - Schema27LinePoolUsed Then Return 0
+    Schema27RowCount += 1
+    With Schema27Rows(Schema27RowCount)
+        .LineOffset = Schema27LinePoolUsed
+        .LineLength = Len(LineText)
+        If .LineLength > 0 Then _
+            Mid$(Schema27LinePool, Schema27LinePoolUsed + 1, .LineLength) = LineText
+        Schema27LinePoolUsed += .LineLength
+        .KeyText = KeyText
+        .ModuleOrdinal = ModuleOrdinal
+        Bucket = Schema27IndexBucket(KeyText)
+        .NextHash = Schema27HashHeads(Bucket)
+        Schema27HashHeads(Bucket) = Schema27RowCount
+    End With
+    If Schema27TagTails(TagIndex) > 0 Then _
+        Schema27Rows(Schema27TagTails(TagIndex)).NextTag = Schema27RowCount
+    Schema27TagTails(TagIndex) = Schema27RowCount
+    If Schema27TagHeads(TagIndex) = 0 Then Schema27TagHeads(TagIndex) = Schema27RowCount
+    Schema27TagCounts(TagIndex) += 1
+    Return -1
+End Function
+
+' -------------------------------------------------------------------------
+' Shared range, identity and context checks
+' -------------------------------------------------------------------------
+
+Function Schema27Subject(ByVal DomainText As String, ByVal IdentityText As String, _
+    ByVal Nullable As Integer = 0) As LongInt
+    If Schema20Decimal(IdentityText, 0) = 0 Then Return 0
+    If IdentityText = "0" Then Return IIf(Nullable <> 0, -1, 0)
+    Select Case DomainText
+    Case "symbol": Return Schema27Find("S", IdentityText)
+    Case "node": Return Schema27Find("N", IdentityText)
+    Case "expression": Return Schema27Find("E", IdentityText)
+    Case "binding": Return Schema27Find("B", IdentityText)
+    Case "declaration": Return Schema27Find("DCL", IdentityText)
+    Case "conditional": Return Schema27Find("PPB", IdentityText)
+    Case "conditional-end": Return Schema27Find("PPE", IdentityText)
+    Case "defined-probe": Return Schema27Find("PPT", IdentityText)
+    Case "macro-attempt", "macro-argument": Return Schema27Find("MI", IdentityText)
+    Case "macro-lifetime": Return Schema27Find("ML", IdentityText)
+    Case "source-context": Return Schema27Find("SRC", IdentityText)
+    Case "include": Return Schema27Find("INC", IdentityText)
+    Case "remap": Return Schema27Find("MAP", IdentityText)
+    Case "statement": Return Schema27Find("ST", IdentityText)
+    Case "construct": Return Schema27Find("BLK", IdentityText)
+    End Select
+    Return 0
+End Function
+
+Function Schema27Location(Fields() As String, ByVal Offset As Integer, _
+    ByVal EmptyAllowed As Integer = 0) As Integer
+    Dim As LongInt StartLine, StartColumn, EndLine, EndColumn
+    If Schema20Flag(Fields(Offset - 1)) = 0 Then Return 0
+    If Len(Fields(Offset)) = 0 Then
+        If EmptyAllowed = 0 OrElse Fields(Offset - 1) <> "0" Then Return 0
+        For I As Integer = Offset + 1 To Offset + 4
+            If Fields(I) <> "0" Then Return 0
+        Next I
+        Return -1
+    End If
+    For I As Integer = Offset + 1 To Offset + 4
+        If Schema20Decimal(Fields(I), 0) = 0 Then Return 0
+    Next I
+    If FblintParseSemanticInteger(Fields(Offset + 1), StartLine) = 0 OrElse _
+       FblintParseSemanticInteger(Fields(Offset + 2), StartColumn) = 0 OrElse _
+       FblintParseSemanticInteger(Fields(Offset + 3), EndLine) = 0 OrElse _
+       FblintParseSemanticInteger(Fields(Offset + 4), EndColumn) = 0 Then Return 0
+    If StartLine < 1 OrElse EndLine < StartLine Then Return 0
+    If EndLine = StartLine Then
+        If EndColumn < StartColumn OrElse (Fields(Offset - 1) = "1" AndAlso EndColumn = StartColumn) Then Return 0
+    End If
+    Return -1
+End Function
+
+Function Schema27LiveSource(ByVal IdentityText As String, ByVal ModuleOrdinal As LongInt) As Integer
+    Dim As LongInt RowIndex = Schema27Find("SRC", IdentityText)
+    Return (RowIndex > 0 AndAlso Schema27Number(RowIndex, 4) = ModuleOrdinal AndAlso _
+        Schema27Find("SRE", IdentityText) = 0)
+End Function
+
+Function Schema27Configuration(ByVal IdentityText As String, _
+    ByVal ModuleOrdinal As LongInt, ByVal Nullable As Integer = 0) As Integer
+    If IdentityText = "0" Then Return Nullable
+    Return (Schema20Decimal(IdentityText, 0) <> 0 AndAlso _
+        Schema27Number(Schema27Find("CTX", IdentityText), 2) = ModuleOrdinal)
+End Function
+
+Function Schema27Units(ByVal KindText As String, ByRef ValueText As String) As LongInt
+    If KindText = "bytes" Then Return Len(ValueText)
+    If KindText = "wide-units" AndAlso Schema20Hex(ValueText, 8) <> 0 Then Return Len(ValueText) \ 8
+    Return -1
+End Function
+
+' Additional validators keep source, AST and macro responsibilities separate.
+#Include "fb_linter_semantic_schema27_source.bi"
+#Include "fb_linter_semantic_schema27_graphs.bi"
+
+' -------------------------------------------------------------------------
+' Complete-model entry point
+' -------------------------------------------------------------------------
+
+Function FblintValidateSchema27Metadata(ByRef ModelPath As String, _
+    LatestTypes() As String, CanonicalIds() As LongInt) As Integer
+    Dim As Integer FileNumber = FreeFile
+    Dim As Integer Valid = -1, FirstLine = -1, FooterSeen
+    Dim As LongInt ModuleOrdinal, FileSize
+    Dim As UByte FinalByte
+    Dim As String LineText
+    Dim As String Fields(0 To 18)
+    ResetSchema27Facts
+    Erase LatestTypes
+    Erase CanonicalIds
+    If Open(ModelPath For Binary Access Read As #FileNumber) <> 0 Then Return 0
+    FileSize = Lof(FileNumber)
+    If FileSize > 0 Then Get #FileNumber, FileSize, FinalByte
+    Close #FileNumber
+    If FileSize = 0 OrElse FileSize > SCHEMA27_BYTE_LIMIT OrElse FinalByte <> 10 Then Return 0
+    While Schema27HashSize < SCHEMA27_MAX_HASH_SIZE AndAlso _
+          Schema27HashSize < FileSize \ SCHEMA27_HASH_ROW_BYTES
+        Schema27HashSize *= 2
+    Wend
+    Schema27Trace("schema 27 index: " + ModelPath)
+    Schema27LinePool = Space$(FileSize)
+    Schema27LinePoolUsed = 0
+    If Open(ModelPath For Input As #FileNumber) <> 0 Then Return 0
+    Do While Eof(FileNumber) = 0
+        Line Input #FileNumber, LineText
+        If FooterSeen <> 0 OrElse Schema20Fields(LineText, Fields(), "27") = 0 Then Valid = 0: Exit Do
+        If FirstLine <> 0 Then
+            FirstLine = 0
+            If Fields(0) <> "FBCSEM" OrElse Fields(1) <> "27" OrElse Len(Fields(2)) = 0 Then Valid = 0: Exit Do
+        ElseIf Fields(0) = "FBCSEM" OrElse Fields(0) = "R" Then
+            Valid = 0: Exit Do
+        End If
+        If Fields(0) = "M" Then ModuleOrdinal += 1
+        If Schema27ValidateSourceRecord(Fields(), ModuleOrdinal) = 0 OrElse _
+           Schema27Add(Fields(), LineText, ModuleOrdinal) = 0 Then
+            Schema27Failure = "record " + Fields(0)
+            Valid = 0: Exit Do
+        End If
+        If Fields(0) = "END" Then FooterSeen = -1
+    Loop
+    Valid = (Valid <> 0 AndAlso FooterSeen <> 0 AndAlso Eof(FileNumber) <> 0)
+    Close #FileNumber
+    Schema27Trace("schema 27 indexed rows=" + LTrim(Str(Schema27RowCount)))
+    If Valid <> 0 Then Valid = Schema27ValidateGraphs()
+    If Valid <> 0 Then
+        Schema27Failure = "shared symbol metadata"
+        Schema27Trace("schema 27 shared symbol metadata")
+        Valid = FblintValidateSchema20Metadata(ModelPath, LatestTypes(), CanonicalIds(), "27")
+    End If
+    If Valid = 0 Then
+        Dim As String FailureText = Schema27Failure
+        ResetSchema27Facts
+        Schema27Failure = FailureText
+        Erase LatestTypes
+        Erase CanonicalIds
+    Else
+        Schema27Failure = ""
+        Schema27FactsComplete = -1
+    End If
+    Schema27Trace("schema 27 metadata status=" + LTrim(Str(Valid)))
+    Return Valid
+End Function
+
+' -------------------------------------------------------------------------
+' Scoped secondary-model validation
+' -------------------------------------------------------------------------
+
+Type Schema27IndexSnapshot
+    Rows(Any) As Schema27Record
+    Aliases(Any) As Schema27AliasRecord
+    HashHeads(Any) As LongInt
+    AliasHeads(Any) As LongInt
+    TagHeads(0 To 67) As LongInt
+    TagTails(0 To 67) As LongInt
+    TagCounts(0 To 67) As LongInt
+    RowCount As Long
+    Capacity As Long
+    AliasCount As Long
+    AliasCapacity As Long
+    HashSize As Integer
+    LinePoolUsed As Long
+    LinePool As String
+    IndexNonce As LongInt
+    FactsComplete As Integer
+    Failure As String
+    StatementTop As String
+    ConstructTop As String
+    ConditionalTop As String
+    Active As Integer
+End Type
+
+Function Schema27SuspendIndex(ByRef Saved As Schema27IndexSnapshot) As Integer
+    If Saved.Active <> 0 OrElse Schema27RowCount < 0 OrElse _
+       Schema27Capacity < Schema27RowCount OrElse _
+       Schema27HashSize < SCHEMA27_HASH_SIZE OrElse _
+       Schema27HashSize > SCHEMA27_MAX_HASH_SIZE Then Return 0
+    Saved.RowCount = Schema27RowCount
+    Saved.Capacity = Schema27RowCount + 1
+    Saved.AliasCount = Schema27AliasCount
+    Saved.AliasCapacity = Schema27AliasCount + 1
+    Saved.HashSize = Schema27HashSize
+    Saved.LinePoolUsed = Schema27LinePoolUsed
+    Swap Schema27LinePool, Saved.LinePool
+    Saved.IndexNonce = Schema27IndexNonce
+    Saved.FactsComplete = Schema27FactsComplete
+    Saved.Failure = Schema27Failure
+    Saved.StatementTop = Schema27StatementTop
+    Saved.ConstructTop = Schema27ConstructTop
+    Saved.ConditionalTop = Schema27ConditionalTop
+    ReDim Saved.Rows(0 To Saved.RowCount)
+    ReDim Saved.Aliases(0 To Saved.AliasCount)
+    ReDim Saved.HashHeads(0 To Saved.HashSize - 1)
+    ReDim Saved.AliasHeads(0 To Saved.HashSize - 1)
+    ' SWAP transfers the managed strings rather than copying their storage
+    ' descriptors. No caller may retain a row reference across this scope.
+    For RowIndex As LongInt = 1 To Saved.RowCount
+        Swap Schema27Rows(RowIndex), Saved.Rows(RowIndex)
+    Next RowIndex
+    For AliasIndex As Long = 1 To Saved.AliasCount
+        Swap Schema27Aliases(AliasIndex), Saved.Aliases(AliasIndex)
+    Next AliasIndex
+    For TagIndex As Integer = 0 To UBound(Schema27TagHeads)
+        Saved.TagHeads(TagIndex) = Schema27TagHeads(TagIndex)
+        Saved.TagTails(TagIndex) = Schema27TagTails(TagIndex)
+        Saved.TagCounts(TagIndex) = Schema27TagCounts(TagIndex)
+    Next TagIndex
+    For Bucket As Integer = 0 To Saved.HashSize - 1
+        Saved.HashHeads(Bucket) = Schema27HashHeads(Bucket)
+        Saved.AliasHeads(Bucket) = Schema27AliasHeads(Bucket)
+    Next Bucket
+    Saved.Active = -1
+    ResetSchema27Facts
+    Return -1
+End Function
+
+Sub Schema27ResumeIndex(ByRef Saved As Schema27IndexSnapshot)
+    If Saved.Active = 0 Then Exit Sub
+    ResetSchema27Facts
+    Schema27HashSize = Saved.HashSize
+    If Saved.Capacity > 0 Then ReDim Schema27Rows(0 To Saved.Capacity - 1)
+    If Saved.AliasCapacity > 0 Then ReDim Schema27Aliases(0 To Saved.AliasCapacity - 1)
+    For RowIndex As LongInt = 1 To Saved.RowCount
+        Swap Schema27Rows(RowIndex), Saved.Rows(RowIndex)
+    Next RowIndex
+    For AliasIndex As Long = 1 To Saved.AliasCount
+        Swap Schema27Aliases(AliasIndex), Saved.Aliases(AliasIndex)
+    Next AliasIndex
+    For TagIndex As Integer = 0 To UBound(Schema27TagHeads)
+        Schema27TagHeads(TagIndex) = Saved.TagHeads(TagIndex)
+        Schema27TagTails(TagIndex) = Saved.TagTails(TagIndex)
+        Schema27TagCounts(TagIndex) = Saved.TagCounts(TagIndex)
+    Next TagIndex
+    For Bucket As Integer = 0 To Saved.HashSize - 1
+        Schema27HashHeads(Bucket) = Saved.HashHeads(Bucket)
+        Schema27AliasHeads(Bucket) = Saved.AliasHeads(Bucket)
+    Next Bucket
+    Schema27RowCount = Saved.RowCount
+    Schema27Capacity = Saved.Capacity
+    Schema27AliasCount = Saved.AliasCount
+    Schema27AliasCapacity = Saved.AliasCapacity
+    Schema27LinePoolUsed = Saved.LinePoolUsed
+    Swap Schema27LinePool, Saved.LinePool
+    Schema27IndexNonce = Saved.IndexNonce
+    Schema27FactsComplete = Saved.FactsComplete
+    Schema27Failure = Saved.Failure
+    Schema27StatementTop = Saved.StatementTop
+    Schema27ConstructTop = Saved.ConstructTop
+    Schema27ConditionalTop = Saved.ConditionalTop
+    Saved.Active = 0
+    Erase Saved.Rows
+    Erase Saved.Aliases
+    Erase Saved.HashHeads
+    Erase Saved.AliasHeads
+End Sub
+
+Function FblintValidateSecondaryMetadata(ByRef ModelPath As String, _
+    LatestTypes() As String, CanonicalIds() As LongInt, ByRef SchemaText As String, _
+    ByRef WorkLeft As LongInt) As Integer
+    Dim As Integer FileNumber = FreeFile, Valid
+    Dim As String HeaderText
+    Erase LatestTypes
+    Erase CanonicalIds
+    SchemaText = ""
+    If Open(ModelPath For Input As #FileNumber) <> 0 Then Return 0
+    If Eof(FileNumber) = 0 Then Line Input #FileNumber, HeaderText
+    Close #FileNumber
+    If FblintTsvField(HeaderText, 0) <> "FBCSEM" Then Return 0
+    SchemaText = FblintTsvField(HeaderText, 1)
+    Select Case SchemaText
+    Case "20"
+        Return FblintValidateSchema20Metadata(ModelPath, LatestTypes(), CanonicalIds())
+    Case "27"
+        WorkLeft -= Schema27RowCount + Schema27HashSize * 2
+        If WorkLeft < 0 Then Return 0
+        Dim As Schema27IndexSnapshot Saved
+        If Schema27SuspendIndex(Saved) = 0 Then Return 0
+        Valid = FblintValidateSchema27Metadata(ModelPath, LatestTypes(), CanonicalIds())
+        ' Restore even after rejection. The calling rule continues to own the
+        ' original program's aliases, scratch fields and reporting provenance.
+        Schema27ResumeIndex Saved
+        Return Valid
+    End Select
+    Return 0
+End Function
+
+#EndIf
+' end of fb_linter_semantic_schema27.bi
