-Function Schema27Value(ByVal RowIndex As Long, ByVal FieldIndex As Integer) As String
+Function Schema27UncachedValue(ByVal RowIndex As Long, ByVal FieldIndex As Integer) As String
     Dim As String Result, LineText
     If RowIndex < 1 OrElse RowIndex > Schema27RowCount Then Return ""
     LineText = Schema27LineText(RowIndex)
     If FblintSemanticDecodeField(FblintTsvField(LineText, FieldIndex), Result) = 0 Then Return ""
     Return Result
+End Function
+
+' One derived cache belongs to the exact immutable row index. A replacement
+' index, restored snapshot or changed budget causes a fresh set of boundaries.
+' Raw offsets and pooled bytes are immutable for that index; row work fields
+' remain independent. The scan is single-threaded. The cap covers retained
+' arrays, and a low budget leaves uncached reads available.
+Const SCHEMA27_FIELD_CACHE_BYTES As LongInt = 128 * 1024 * 1024
+Dim Shared As LongInt Schema27FieldCacheBudget = SCHEMA27_FIELD_CACHE_BYTES
+Dim Shared As LongInt Schema27FieldCacheOwner, Schema27FieldCacheOwnerBudget
+Dim Shared As Long Schema27FieldCacheRows, Schema27FieldCacheUsed = 1, Schema27FieldCacheCapacity
+Dim Shared Schema27FieldCacheMap() As Long
+Dim Shared Schema27FieldCacheStarts() As ULong
+Dim Shared As Integer Schema27FieldCacheDisabled
+
+Function Schema27Value(ByVal RowIndex As Long, ByVal FieldIndex As Integer) As String
+    If RowIndex < 1 OrElse RowIndex > Schema27RowCount OrElse FieldIndex < 0 Then Return ""
+    If Schema27IndexNonce <= 0 OrElse Schema27FactsComplete = 0 Then Return Schema27UncachedValue(RowIndex, FieldIndex)
+    If Schema27FieldCacheOwner <> Schema27IndexNonce OrElse Schema27FieldCacheRows <> Schema27RowCount OrElse Schema27FieldCacheOwnerBudget <> Schema27FieldCacheBudget Then
+        Erase Schema27FieldCacheMap
+        Erase Schema27FieldCacheStarts
+        Schema27FieldCacheUsed = 1
+        Schema27FieldCacheCapacity = 0
+        Schema27FieldCacheDisabled = 0
+        Schema27FieldCacheOwner = Schema27IndexNonce
+        Schema27FieldCacheRows = Schema27RowCount
+        Schema27FieldCacheOwnerBudget = Schema27FieldCacheBudget
+        If Schema27FieldCacheBudget <= 0 OrElse Schema27FieldCacheBudget > SCHEMA27_FIELD_CACHE_BYTES OrElse _
+           (CLngInt(Schema27FieldCacheRows) + 1) * Sizeof(Long) >= Schema27FieldCacheBudget Then
+            Schema27FieldCacheDisabled = -1
+        Else
+            ReDim Schema27FieldCacheMap(0 To Schema27FieldCacheRows)
+        End If
+    End If
+    If Schema27FieldCacheDisabled Then Return Schema27UncachedValue(RowIndex, FieldIndex)
+    Dim As Long Slot = Schema27FieldCacheMap(RowIndex)
+    If Slot = 0 Then
+        Dim As String LineText = Schema27LineText(RowIndex)
+        Dim As Long FieldCount = FblintTsvFieldCount(LineText)
+        Dim As LongInt Needed = CLngInt(Schema27FieldCacheUsed) + FieldCount + 2
+        Dim As LongInt Available = (Schema27FieldCacheBudget - (CLngInt(Schema27FieldCacheRows) + 1) * Sizeof(Long)) \ Sizeof(ULong)
+        If Needed > Available Then
+            Schema27FieldCacheMap(RowIndex) = -1
+            Return Schema27UncachedValue(RowIndex, FieldIndex)
+        End If
+        If Needed > Schema27FieldCacheCapacity Then
+            Dim As LongInt NewCapacity = IIf(Schema27FieldCacheCapacity = 0, 1024, Schema27FieldCacheCapacity)
+            Do While NewCapacity < Needed
+                NewCapacity *= 2
+            Loop
+            If NewCapacity > Available Then NewCapacity = Available
+            If Schema27FieldCacheCapacity = 0 Then
+                ReDim Schema27FieldCacheStarts(0 To NewCapacity - 1)
+            Else
+                ReDim Preserve Schema27FieldCacheStarts(0 To NewCapacity - 1)
+            End If
+            Schema27FieldCacheCapacity = NewCapacity
+        End If
+        Slot = Schema27FieldCacheUsed
+        Schema27FieldCacheStarts(Slot) = FieldCount
+        Dim As Long StartPosition = 0
+        For Index As Long = 0 To FieldCount - 1
+            Schema27FieldCacheStarts(Slot + 1 + Index) = StartPosition
+            If Index < FieldCount - 1 Then StartPosition = InStr(StartPosition + 1, LineText, Chr(9))
+        Next Index
+        Schema27FieldCacheStarts(Slot + FieldCount + 1) = Len(LineText) + 1
+        Schema27FieldCacheUsed = Needed
+        ' Publish only the complete boundaries for this row.
+        Schema27FieldCacheMap(RowIndex) = Slot
+    End If
+    If Slot < 0 Then Return Schema27UncachedValue(RowIndex, FieldIndex)
+    If FieldIndex >= Schema27FieldCacheStarts(Slot) Then Return ""
+    Dim As LongInt FieldStart = Schema27FieldCacheStarts(Slot + 1 + FieldIndex)
+    Dim As LongInt FieldLength = Schema27FieldCacheStarts(Slot + 2 + FieldIndex) - FieldStart - 1
+    Dim As String ResultText
+    If FblintSemanticDecodeField(Mid(Schema27LinePool, Schema27Rows(RowIndex).LineOffset + 1 + FieldStart, FieldLength), ResultText) = 0 Then Return ""
+    Return ResultText
 End Function
 
