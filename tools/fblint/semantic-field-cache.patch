-' -------------------------------------------------------------------------
-' Shared range, identity and context checks
-' -------------------------------------------------------------------------
-
-Function Schema27Subject(ByVal DomainText As String, ByVal IdentityText As String, _
-    ByVal Nullable As Integer = 0) As LongInt
-    If Schema20Decimal(IdentityText, 0) = 0 Then Return 0
-    If IdentityText = "0" Then Return IIf(Nullable <> 0, -1, 0)
-    Select Case DomainText
-    Case "symbol": Return Schema27Find("S", IdentityText)
-    Case "node": Return Schema27Find("N", IdentityText)
-    Case "expression": Return Schema27Find("E", IdentityText)
-    Case "binding": Return Schema27Find("B", IdentityText)
-    Case "declaration": Return Schema27Find("DCL", IdentityText)
-    Case "conditional": Return Schema27Find("PPB", IdentityText)
-    Case "conditional-end": Return Schema27Find("PPE", IdentityText)
-    Case "defined-probe": Return Schema27Find("PPT", IdentityText)
-    Case "macro-attempt", "macro-argument": Return Schema27Find("MI", IdentityText)
-    Case "macro-lifetime": Return Schema27Find("ML", IdentityText)
-    Case "source-context": Return Schema27Find("SRC", IdentityText)
-    Case "include": Return Schema27Find("INC", IdentityText)
-    Case "remap": Return Schema27Find("MAP", IdentityText)
-    Case "statement": Return Schema27Find("ST", IdentityText)
-    Case "construct": Return Schema27Find("BLK", IdentityText)
-    End Select
-    Return 0
-End Function
-
-Function Schema27Location(Fields() As String, ByVal Offset As Integer, _
-    ByVal EmptyAllowed As Integer = 0) As Integer
-    Dim As LongInt StartLine, StartColumn, EndLine, EndColumn
-    If Schema20Flag(Fields(Offset - 1)) = 0 Then Return 0
-    If Len(Fields(Offset)) = 0 Then
-        If EmptyAllowed = 0 OrElse Fields(Offset - 1) <> "0" Then Return 0
-        For I As Integer = Offset + 1 To Offset + 4
-            If Fields(I) <> "0" Then Return 0
-        Next I
-        Return -1
-    End If
-    For I As Integer = Offset + 1 To Offset + 4
-        If Schema20Decimal(Fields(I), 0) = 0 Then Return 0
-    Next I
-    If FblintParseSemanticInteger(Fields(Offset + 1), StartLine) = 0 OrElse _
-       FblintParseSemanticInteger(Fields(Offset + 2), StartColumn) = 0 OrElse _
-       FblintParseSemanticInteger(Fields(Offset + 3), EndLine) = 0 OrElse _
-       FblintParseSemanticInteger(Fields(Offset + 4), EndColumn) = 0 Then Return 0
-    If StartLine < 1 OrElse EndLine < StartLine Then Return 0
-    If EndLine = StartLine Then
-        If EndColumn < StartColumn OrElse (Fields(Offset - 1) = "1" AndAlso EndColumn = StartColumn) Then Return 0
-    End If
-    Return -1
-End Function
-
-Function Schema27LiveSource(ByVal IdentityText As String, ByVal ModuleOrdinal As LongInt) As Integer
-    Dim As LongInt RowIndex = Schema27Find("SRC", IdentityText)
-    Return (RowIndex > 0 AndAlso Schema27Number(RowIndex, 4) = ModuleOrdinal AndAlso _
-        Schema27Find("SRE", IdentityText) = 0)
-End Function
-
-Function Schema27Configuration(ByVal IdentityText As String, _
-    ByVal ModuleOrdinal As LongInt, ByVal Nullable As Integer = 0) As Integer
-    If IdentityText = "0" Then Return Nullable
-    Return (Schema20Decimal(IdentityText, 0) <> 0 AndAlso _
-        Schema27Number(Schema27Find("CTX", IdentityText), 2) = ModuleOrdinal)
-End Function
-
-Function Schema27Units(ByVal KindText As String, ByRef ValueText As String) As LongInt
-    If KindText = "bytes" Then Return Len(ValueText)
-    If KindText = "wide-units" AndAlso Schema20Hex(ValueText, 8) <> 0 Then Return Len(ValueText) \ 8
-    Return -1
-End Function
