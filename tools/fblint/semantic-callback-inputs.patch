+Private Function CallbackSignatureMark(ByVal SymbolRow As LongInt, ByVal Stamp As Long, _
+    Seen() As Long, Queue() As Long, ByRef Count As LongInt) As Integer
+    If SymbolRow = 0 OrElse Seen(SymbolRow) = Stamp Then Return -1
+    If Schema27Value(Schema27Find("F", Schema27Value(SymbolRow, 1)), 2) <> "procedure-pointer" Then Return -1
+    If Count >= UBound(Queue) Then Return 0
+    Seen(SymbolRow) = Stamp: Count += 1: Queue(Count) = CLng(SymbolRow)
+    Return -1
+End Function
+
+Private Function MarkCallbackSignature(ByVal RootRow As LongInt, ByVal Stamp As Long, Seen() As Long, _
+    Queue() As Long, ByRef WorkLeft As LongInt) As Integer
+    Dim As LongInt Count = 1, Position = 1
+    Queue(1) = CLng(RootRow): Seen(RootRow) = Stamp
+    Do While Position <= Count
+        WorkLeft -= 1: If WorkLeft < 0 Then Return 0
+        Dim As String SymbolId = Schema27Value(Queue(Position), 1)
+        Dim As LongInt TypeRow = Schema27Find("T", SymbolId), SignatureRow = Schema27Find("F", SymbolId)
+        Dim As LongInt SubType = Schema27Subject("symbol", Schema27Value(TypeRow, 7))
+        If CallbackSignatureMark(SubType, Stamp, Seen(), Queue(), Count) = 0 Then Return 0
+        For Ordinal As LongInt = 0 To Schema27Number(SignatureRow, 4) - 1
+            WorkLeft -= 1: If WorkLeft < 0 Then Return 0
+            Dim As LongInt FormalRow = Schema27Find("G", SymbolId, LTrim(Str(Ordinal)))
+            Dim As LongInt FormalType = Schema27Find("T", Schema27Value(FormalRow, 2))
+            SubType = Schema27Subject("symbol", Schema27Value(FormalType, 7))
+            If CallbackSignatureMark(SubType, Stamp, Seen(), Queue(), Count) = 0 Then Return 0
+        Next Ordinal
+        Position += 1
+    Loop
+    Return -1
+End Function
