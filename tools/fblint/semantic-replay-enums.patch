+' Project: fb-linter
+' File: fb_linter_boolean_replay_enums.bi
+' Purpose: Preserve anonymous enum identity across compiler replay frames.
+' Responsibilities: Bound enum ordinals and replace compiler-generated type spellings.
+' This file intentionally does NOT rename source types or compare complete AST frames.
+'
+' T records identify anonymous enums by their enum class and compiler origin.
+' Their generated names share a counter with unrelated compiler temporaries.
+' Declaration order supplies a distinct identity for each such enum; the frame
+' comparison still checks every statement, node type, constant and property.
+' Callers own a fully validated schema-27 index and remain on its analysis thread.
+#Ifndef FB_LINTER_BOOLEAN_REPLAY_ENUMS_BI
+#Define FB_LINTER_BOOLEAN_REPLAY_ENUMS_BI
+
+Function BooleanReplayEnumOrdinals(Ordinals() As Long) As Integer
+    Dim As LongInt RowIndex = Schema27First("T"), HighestId, Identity
+    Do While RowIndex > 0
+        If Schema27Value(RowIndex, 3) = "enum" AndAlso Schema27Value(RowIndex, 18) = "compiler" Then
+            Identity = Schema27Number(RowIndex, 1)
+            If Identity < 1 OrElse Identity > FBLINT_MAX_SEMANTIC_MODEL_IDENTITIES Then Return 0
+            If Identity > HighestId Then HighestId = Identity
+        End If
+        RowIndex = Schema27Rows(RowIndex).NextTag
+    Loop
+    ReDim Ordinals(0 To HighestId)
+    Dim As Long Count
+    RowIndex = Schema27First("T")
+    Do While RowIndex > 0
+        If Schema27Value(RowIndex, 3) = "enum" AndAlso Schema27Value(RowIndex, 18) = "compiler" Then
+            Identity = Schema27Number(RowIndex, 1)
+            Count += 1
+            Ordinals(Identity) = Count
+        End If
+        RowIndex = Schema27Rows(RowIndex).NextTag
+    Loop
+    Return -1
+End Function
+
+Function BooleanReplayBindingType(ByVal TypeRow As LongInt, Ordinals() As Long) As String
+    Dim As LongInt EnumRow, Identity
+    If Schema27Value(TypeRow, 3) = "enum" Then
+        EnumRow = TypeRow
+    Else
+        EnumRow = Schema27Find("T", Schema27Value(TypeRow, 7))
+    End If
+    If EnumRow > 0 AndAlso Schema27Value(EnumRow, 3) = "enum" AndAlso _
+       Schema27Value(EnumRow, 18) = "compiler" Then
+        Identity = Schema27Number(EnumRow, 1)
+        If Identity > 0 AndAlso Identity <= UBound(Ordinals) AndAlso Ordinals(Identity) > 0 Then
+            Return Schema27Key("compiler-enum", LTrim(Str(Ordinals(Identity))), _
+                Schema27Value(EnumRow, 6), Schema27Value(EnumRow, 10))
+        End If
+    End If
+    Return Schema27Value(TypeRow, 5)
+End Function
+
+#Endif
+' end of fb_linter_boolean_replay_enums.bi
