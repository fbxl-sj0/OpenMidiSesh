--- /dev/null
+++ b/src/fb_linter_semantic_context.bi
@@ -0,0 +1,139 @@
+' Project: fb-linter
+' File: fb_linter_semantic_context.bi
+' Purpose: Analyze included sources in their actual compilation context.
+' Responsibilities: Quote build inputs and own one source-verified model cache.
+' This file intentionally does NOT validate semantic records or report lint rules.
+'
+' The scan is single-threaded. This process owns the reserved compiler paths
+' until the scan finishes. FILE records in a validated schema-27 model supply
+' physical source hashes. Every reuse checks those hashes against disk, so a
+' changed include cannot silently inherit facts from an earlier compilation.
+
+#Ifndef FB_LINTER_SEMANTIC_CONTEXT_BI
+#Define FB_LINTER_SEMANTIC_CONTEXT_BI
+
+#Ifdef __FB_WIN32__
+#Include Once "win/wincrypt.bi"
+#Endif
+
+Type FblintContextSource
+    Path As String
+    Digest As String
+End Type
+
+Dim Shared ContextSources() As FblintContextSource
+Dim Shared As Integer ContextSourceCount
+Dim Shared As String ContextBasePath, ContextModelPath, ContextOutputPath
+Dim Shared As String ContextDiagnosticPath, ContextCompilerOutput, ContextModelDigest
+Dim Shared As Integer ContextAnalysisFailed
+Dim Shared As String ContextFailureReason
+
+Function FblintContextArguments(ByRef Values As String, ByRef FlagText As String) As String
+    Dim As String ResultText
+    Dim As Integer Cursor = 1, LineEnd
+    Do While Cursor <= Len(Values)
+        LineEnd = InStr(Cursor, Values, Chr(10))
+        If LineEnd = 0 Then Exit Do
+        ResultText += FlagText + FblintQuoteWindowsArgument(Mid(Values, Cursor, LineEnd - Cursor))
+        Cursor = LineEnd + 1
+    Loop
+    Return ResultText
+End Function
+
+Function FblintContextDigest(ByRef FilePath As String) As String
+#Ifdef __FB_WIN32__
+    Dim As HCRYPTPROV Provider
+    Dim As HCRYPTHASH HashHandle
+    Dim As Integer FileNumber = FreeFile, Valid = -1
+    Dim As LongInt Remaining
+    Dim As DWORD ByteCount, DigestSize = 32
+    Dim As UByte Buffer(0 To 65535), Digest(0 To 31)
+    Dim As String ResultText
+    If CryptAcquireContextA(@Provider, Null, Null, PROV_RSA_AES, CRYPT_VERIFYCONTEXT) = 0 Then Return ""
+    If CryptCreateHash(Provider, CALG_SHA_256, 0, 0, @HashHandle) = 0 Then
+        CryptReleaseContext(Provider, 0)
+        Return ""
+    End If
+    If Open(FilePath For Binary Access Read As #FileNumber) <> 0 Then
+        Valid = 0
+    Else
+        Remaining = Lof(FileNumber)
+        Do While Remaining > 0
+            ByteCount = IIf(Remaining > Sizeof(Buffer), Sizeof(Buffer), Remaining)
+            If Get(#FileNumber, , Buffer(0), ByteCount) <> 0 Then Valid = 0: Exit Do
+            If CryptHashData(HashHandle, @Buffer(0), ByteCount, 0) = 0 Then Valid = 0: Exit Do
+            Remaining -= ByteCount
+        Loop
+        Close #FileNumber
+    End If
+    If Valid <> 0 AndAlso CryptGetHashParam(HashHandle, HP_HASHVAL, @Digest(0), @DigestSize, 0) <> 0 Then
+        For I As Integer = 0 To 31
+            ResultText += LCase(Hex(Digest(I), 2))
+        Next I
+    End If
+    CryptDestroyHash(HashHandle)
+    CryptReleaseContext(Provider, 0)
+    Return ResultText
+#Else
+    Return ""
+#Endif
+End Function
+
+Function FblintContextSourcesCurrent() As Integer
+    If ContextSourceCount = 0 Then Return 0
+    If FblintContextDigest(ContextModelPath) <> ContextModelDigest Then Return 0
+    For I As Integer = 0 To ContextSourceCount - 1
+        If FblintContextDigest(ContextSources(I).Path) <> ContextSources(I).Digest Then Return 0
+    Next I
+    Return -1
+End Function
+
+Function FblintCaptureContextSources(ByRef ModelPath As String, ByRef SourcePath As String) As Integer
+    Dim As Integer FileNumber = FreeFile, Present, Valid = -1
+    Dim As String LineText, PhysicalPath, SourceKind
+    If ContextSourceCount = 0 Then
+        ' Bound metadata storage independently of the compiler's artifact size.
+        ReDim ContextSources(0 To 4095)
+        If Open(ModelPath For Input As #FileNumber) <> 0 Then Return 0
+        Do While Eof(FileNumber) = 0
+            Line Input #FileNumber, LineText
+            If Left(LineText, 5) <> "FILE" + Chr(9) Then Continue Do
+            SourceKind = FblintTsvField(LineText, 6)
+            If SourceKind <> "regular" Then Continue Do
+            If ContextSourceCount >= 4096 Then Valid = 0: Exit Do
+            If FblintSemanticDecodeField(FblintTsvField(LineText, 2), PhysicalPath) = 0 Then Valid = 0: Exit Do
+            With ContextSources(ContextSourceCount)
+                .Path = PhysicalPath
+                .Digest = LCase(FblintTsvField(LineText, 4))
+                If FblintContextDigest(.Path) <> .Digest Then Valid = 0: Exit Do
+            End With
+            ContextSourceCount += 1
+        Loop
+        Close #FileNumber
+        If Valid = 0 Then ContextSourceCount = 0: Erase ContextSources: Return 0
+    End If
+    For I As Integer = 0 To ContextSourceCount - 1
+        If ComparablePath(ContextSources(I).Path) = ComparablePath(SourcePath) Then Present = -1
+    Next I
+    Return Present
+End Function
+
+Sub FblintClearContextModel()
+    If Len(ContextBasePath) Then
+        Dim As String ExpressionPath = ContextBasePath + ".fbcexpr"
+        FblintDeleteSemanticTemps ContextBasePath, ContextModelPath, ExpressionPath, ContextOutputPath
+    End If
+    ContextRetainedModelPath = ""
+    Erase ContextLatestTypes
+    Erase ContextCanonicalIds
+    ContextBasePath = ""
+    ContextModelPath = ""
+    ContextSourceCount = 0
+    ContextAnalysisFailed = 0
+    ContextFailureReason = ""
+    Erase ContextSources
+End Sub
+
+#Endif
+
+' end of fb_linter_semantic_context.bi
