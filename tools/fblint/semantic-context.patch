 Function Schema27Bucket(ByRef KeyText As String) As Integer
-    ' Only the low sixteen bits select a bucket. Rotation-only mixing leaves
-    ' trailing numeric IDs outside those bits, clustering hundreds of keys.
+    ' The active power-of-two table selects low hash bits. Rotation-only mixing
