+Function Schema27BuildCoreRows(CoreRows() As Long, ByRef DetailRows As LongInt) As Long
+    ' All detail records remain in the validated index for rule consumers.
+    ' Merge tag chains by their original row positions: procedure and node
+    ' context depends on export order, so concatenating tag lists is unsafe.
+    If Schema27FactsComplete = 0 Then Return 0
+    Dim As String Tags(0 To 9) = {"M", "D", "S", "B", "I", "P", "V", "N", "E", "END"}
+    Dim As Long Positions(0 To 9)
+    Dim As Long CoreCount
+    For TagIndex As Integer = 0 To 9
+        Dim As Integer Ordinal = Schema27Tag(Tags(TagIndex))
+        If Ordinal < 0 OrElse Ordinal > UBound(Schema27TagHeads) Then Return 0
+        Positions(TagIndex) = Schema27TagHeads(Ordinal)
+        If Schema27TagCounts(Ordinal) > Schema27RowCount - CoreCount Then Return 0
+        CoreCount += Schema27TagCounts(Ordinal)
+    Next TagIndex
+    DetailRows = Schema27RowCount - CoreCount - Schema27Count("FBCSEM")
+    If CoreCount < 1 OrElse DetailRows < 0 Then Return 0
+    ReDim CoreRows(0 To CoreCount - 1)
+    For CoreIndex As Long = 0 To CoreCount - 1
+        Dim As Integer Selected = -1
+        For TagIndex As Integer = 0 To 9
+            If Positions(TagIndex) = 0 Then Continue For
+            If Selected < 0 Then
+                Selected = TagIndex
+            ElseIf Positions(TagIndex) < Positions(Selected) Then
+                Selected = TagIndex
+            End If
+        Next TagIndex
+        If Selected < 0 Then Erase CoreRows: Return 0
+        Dim As Long RowIndex = Positions(Selected)
+        If RowIndex < 1 OrElse RowIndex > Schema27RowCount Then Erase CoreRows: Return 0
+        CoreRows(CoreIndex) = RowIndex
+        Positions(Selected) = Schema27Rows(RowIndex).NextTag
+    Next CoreIndex
+    Return CoreCount
 End Function
 
